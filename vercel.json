{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "includeFiles": "{app/**,config/**,content/**,public/**}"
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1",
      "headers": { "cache-control": "public, max-age=604800" }
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
